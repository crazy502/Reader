# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# IDE settings
.idea/
.vscode/

# Local runtime data
data/*
!data/.gitkeep

# Build output
build/
dist/
# PyInstaller .spec files are intentionally tracked for reproducible releases.

# Logs and temporary files
*.log
*.tmp

# Local book files
book/*
!book/.gitkeep

# Operating system files
Thumbs.db
.DS_Store
